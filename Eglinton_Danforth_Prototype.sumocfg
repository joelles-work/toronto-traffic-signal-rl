<?xml version="1.0" encoding="UTF-8"?>
<!-- Vehicle-only, idealized geometry. Not a surveyed Toronto intersection. -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="results/baseline_dev/idealized.net.xml"/>
        <route-files value="results/baseline_dev/seed_11/routes.rou.xml"/>
        <additional-files value="results/baseline_dev/fixed.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="7200"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
    </processing>
    <random_number>
        <seed value="11"/>
    </random_number>
    <gui_only>
        <gui-settings-file value="intersection_view.xml"/>
        <delay value="100"/>
    </gui_only>
</configuration>
